<?xml version="1.0" encoding="utf-8"?>
<!-- The widget sits on someone else's wallpaper, so it brings its own ground
     rather than borrowing a theme it has no access to: near-opaque dark, which
     the white label reads against whatever is behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E61B1C1E" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
